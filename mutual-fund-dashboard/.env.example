# Copy to .env and fill in for your environment. Never commit the real .env.
#
# Base URL of the scoring API (no trailing slash). Vite inlines this into the
# built bundle at build time, so it must be set before `npm run build`, and it
# must be a URL the browser can reach -- not an internal-only hostname.
#
# Leave unset to fall back to http://localhost:8000, which is what a local
# `uvicorn api:app --port 8000` serves.
VITE_API_BASE_URL=https://your-api-host.example.com
